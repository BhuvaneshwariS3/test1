# ARCart AI - Environment Variables Example
# Copy this file to .env and fill in your values

# Backend Configuration
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Database Configuration
DATABASE_URL=sqlite:///database/arcart.db

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Service Configuration
AI_API_KEY=your-ai-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
COMPUTER_VISION_API_KEY=your-computer-vision-api-key-here

# AR Configuration
AR_API_KEY=your-ar-api-key-here
MODEL_3D_STORAGE_URL=https://storage.arcart.ai/models

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-email-password
EMAIL_FROM=noreply@arcart.ai

# Development Flags
DEBUG=true
ENVIRONMENT=development